<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dylan.daily-ai-radar</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/dylan/.claude/skills/daily-ai-radar-workspace/run.sh</string>
  </array>
  <!-- Fires at login/load; the run.sh guard makes repeat fires a no-op -->
  <key>RunAtLoad</key>
  <true/>
  <!-- Also fires at 7:30 daily if the Mac is already awake; launchd coalesces
       missed intervals and fires on next wake -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
</dict>
</plist>
