#!/usr/bin/env bash
#MISE description="Decrypt secrets/env.sops.yaml into ~/.config/secrets/env.sh"
# Keyless: sops (>=3.10) fetches the age key live from 1Password via SOPS_AGE_KEY_CMD;
# the private key never touches disk. Override the item with OP_AGE_REF.
set -euo pipefail
DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OP_AGE_REF="${OP_AGE_REF:-op://Private/sops/SOPS_PRIVATE_KEY}"
if ! command -v op >/dev/null 2>&1; then
  echo "op CLI not found - run 'mise run brew' (installs 1password-cli) first." >&2
  exit 1
fi
# whoami only checks an existing session; read also allows desktop app authentication.
if ! op read "$OP_AGE_REF" >/dev/null; then
  echo "1Password could not read the SOPS age key. See the error above." >&2
  echo "Open the 1Password app, sign in, then enable:" >&2
  echo "  Settings -> Developer -> 'Integrate with 1Password CLI'." >&2
  echo "Approve the CLI request in 1Password, and check OP_AGE_REF if the item was not found." >&2
  echo "(Headless alternative: eval \"\$(op signin)\")" >&2
  exit 1
fi
export SOPS_AGE_KEY_CMD="op read $OP_AGE_REF"
umask 077
mkdir -p "$HOME/.config/secrets"
output=$(mktemp "$HOME/.config/secrets/env.sh.XXXXXX")
trap 'rm -f "$output"' EXIT
sops -d --output-type json "$DOTFILES/secrets/env.sops.yaml" \
  | jq -r 'to_entries[] | if (.key | test("^[A-Za-z_][A-Za-z0-9_]*$")) then "export \(.key)=\(.value | tostring | @sh)" else error("Invalid environment variable name") end' \
  > "$output"
mv "$output" "$HOME/.config/secrets/env.sh"
echo "Wrote ~/.config/secrets/env.sh (sourced by .zprofile on next login shell)."
