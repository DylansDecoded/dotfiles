        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "'/opt/homebrew/opt/moshi-hook/bin/moshi-hook' codex-hook",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash '/Users/dylan/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "'/opt/homebrew/opt/moshi-hook/bin/moshi-hook' codex-hook",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
