.archive
.DS_Store
.DS_STORE
__pycache__/
*.pyc
node_modules/

# Node.js dependencies and package-manager caches
node_modules/
.npm/
.pnpm-store/
.yarn/cache/

# Secrets safety net — only *.sops.yaml ciphertext is allowed in this repo.
# Never commit age private keys or any decrypted output.
keys.txt
**/age/keys.txt
*.dec
secrets/*.env
secrets/env.sh

# Tool artifacts and editor backups
.zcompdump*
.lavish/
*.bak

# Pi agent secrets / runtime (never commit even if copied into home/.pi)
home/.pi/agent/auth.json
home/.pi/agent/mcp-auth.json
home/.pi/agent/models-store.json
home/.pi/agent/sessions/
home/.pi/agent/calm
