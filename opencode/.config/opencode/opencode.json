{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/z-ai/glm-5-turbo",
  "plugin": [
    "@superwhisper/opencode",
    "@tarquinen/opencode-dcp@latest",
    "opencode-openai-codex-auth",
    "opencode-claude-bridge"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8192
  },
  "mcp": {
    "crawler": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "--directory",
        "/Users/dylan/Projects/personal/mcps/searxNcrawl",
        "python",
        "-m",
        "crawler.mcp_server"
      ],
      "enabled": true
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://[::1]:11434/v1",
        "timeout": 600000
      },
      "models": {
        "qwen3.5-9b-opencode": {
          "name": "Qwen3.5 9B Uncensored (OpenCode, 24K)",
          "limit": {
            "context": 24576,
            "output": 4096
          }
        }
      }
    }
  }
}
