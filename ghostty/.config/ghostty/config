# Rose Pine Moon palette with the reference's blue-grey glass tint.
theme = Rose Pine Moon
background = #2b2b3f
background-opacity = 0.80
background-blur = 50

# Fonts
font-family = Hack Nerd Font Mono
font-size = 15
font-thicken = false

# macOS specific
macos-option-as-alt = true
macos-auto-secure-input = true
macos-secure-input-indication = true
# Blend the titlebar into the translucent terminal background.
macos-titlebar-style = transparent
window-title-font-family = Hack Nerd Font Mono

window-padding-balance = false
window-padding-x = 10
window-padding-y = 10

# Application settings
auto-update = download
auto-update-channel = stable
clipboard-trim-trailing-spaces = true
shell-integration = detect

# Window settings
unfocused-split-opacity = 0.5
window-height = 45
window-width = 180

# Cursor settings
cursor-style = block
cursor-style-blink = false
# ssh-env: set TERM/COLORTERM safely when ssh-ing to hosts without ghostty terminfo
# ssh-terminfo: try to copy xterm-ghostty terminfo to the remote host on first connect
shell-integration-features = no-cursor,ssh-env,ssh-terminfo
