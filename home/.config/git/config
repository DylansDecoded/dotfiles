# ~/.config/git/config

[init]
  defaultBranch = master

[web]
  browser = google-chrome

[core]
editor = nvim
excludesfile = ~/.config/git/ignore

[pull]
rebase = true

[push]
  default = simple

[merge]
  tool = kdiff3

[difftool]
  prompt = false

[fetch]
prune = true
pruneTags = true

[user]
  signingkey = 0398512E56790EC3A1A82812A487D2CC5F93DC36

[gpg]
  format = openpgp

[commit]
  gpgsign = true

[color]
  branch = auto
  diff = auto
  interactive = auto
  status = auto
  
[alias]
  c = commit
  ca = commit -a
  cm = commit -m
  cam = commit -am
  d = diff
  dc = diff --cached
  l = log --graph --pretty=format:"%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset" --abbrev-commit

# Dotfiles repo
[includeIf "gitdir:~/dotfiles/"]
path = ~/.config/git/config-personal

# Personal repos
[includeIf "gitdir:~/Projects/personal/"]
